{
  "name": "prompt2scroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "setup": "npm run build && node scripts/install.mjs",
    "codex": "node dist/companion/codex-launch.js",
    "inspect": "node dist/companion/host.js --inspect",
    "lint:extension": "web-ext lint --source-dir dist/extension",
    "package": "npm run build && web-ext build --source-dir dist/extension --artifacts-dir dist --overwrite-dest",
    "release": "npm run package && node scripts/release.mjs"
  },
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0"
  }
}
