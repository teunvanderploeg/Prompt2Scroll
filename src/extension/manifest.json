{
  "manifest_version": 2,
  "name": "Prompt2Scroll",
  "version": "0.1.1",
  "description": "Scroll while your selected coding agents run. Return when they need you.",
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt2scroll@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Prompt2Scroll",
    "default_popup": "popup.html",
    "default_icon": "icons/agent.svg"
  },
  "icons": {
    "48": "icons/agent.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    "blocked.html",
    "blocked.js",
    "ui.css"
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
